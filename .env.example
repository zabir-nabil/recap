# Copy to .env in your working directory, or export these variables before import.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model settings retained from the implementation.
LLM_BIG=gemini-3.5-flash
LLM_BIG_PROVIDER=gemini
LLM_SMALL=gemini-3.1-flash-lite
LLM_SMALL_PROVIDER=gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
RECAP_TAU_DEFAULT=0.5

# GAIA: use a token with access to the gated companion and a web-search key.
HF_TOKEN=
SEARCH_PROVIDER=serper
SERPER_API_KEY=

# SQL-API-Bench: directory containing the prepared Spider distribution.
SQL_API_BENCH_DATA_DIR=./sql_api_bench_data
